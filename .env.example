# 复制为 .env 并填入真实密钥，严禁提交 Git

# ---- LLM：DeepSeek Chat ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 向量化 / 精排：本地 bge 模型（sentence-transformers，无需 API Key）----
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
# HuggingFace 镜像，加速模型下载（境外网络可留空）
HF_ENDPOINT=https://hf-mirror.com

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=goose_qa

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=../data/chroma

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- 检索参数（阶段 2 调优）----
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5

# ---- 阶段 3：知识图谱 + 评估循环 ----
# 图谱数据文件路径（留空用默认 data/knowledge_graph.json）
GRAPH_DATA_PATH=
# 评估循环开关：false 时跳过相关性/充分度评估直接出答案（降级）
EVAL_LOOP_ENABLED=true
# 评估循环最大重检索次数
EVAL_MAX_LOOPS=3
